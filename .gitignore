# --- Secrets & Environment Configurations (CRITICAL) ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json

# --- Python Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pyvenv.cfg

