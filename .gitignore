node_modules/
**/node_modules/
dist/
**/dist/
.dist/
**/.dist/
build/
**/build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Cache & Temporary Files ---
.cache/
**/.cache/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.log

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.sublime-project
